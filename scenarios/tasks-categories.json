    "extensions.commonpost-mcp.blockSkipReview": false,
    "calendar.categories.names": "Zebra,Alpha,Mango",
    "calendar.list.sortOrder": "labstore labics",
    "calendar.registry.labstore.type": "storage",
    "calendar.registry.labstore.uri": "moz-storage-calendar://",
    "calendar.registry.labstore.name": "Lab store",
    "calendar.registry.labstore.disabled": false,
    "calendar.registry.labstore.calendar-main-in-composite": true,
    "calendar.registry.labics.type": "ics",
    "calendar.registry.labics.uri": "file:///lab/profile/Mail/labtasks/msgFilterRules.dat",
    "calendar.registry.labics.name": "Lab ics",
    "calendar.registry.labics.disabled": false,
    "calendar.registry.labics.calendar-main-in-composite": true
  },
