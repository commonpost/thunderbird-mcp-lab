{
  "name": "folders-trash-junk",
  "description": "Folder tools on Local Folders and the POP3 account: renameFolder keeps the messages of the folder and changes its URI, moveFolder puts it under another folder (listFolders shows the new depth and path, the message follows), deleteFolder moves it to the Trash and, from the Trash, deletes it for good with its message. emptyTrash empties the Trash of one account and leaves the other account's Trash alone (the seeded mbox file of the POP3 Trash is emptied too), then of all accounts; emptyJunk empties Local Folders' Junk (the POP3 account has none); getAccountAccess lists both accounts. The main errors are checked: unknown folder or account, a folder name with a backslash, the root folder, a move under the folder's own parent, missing arguments. Nothing is sent.",
  "prefs": {
    "mail.server.server2.directory-rel": "[ProfD]Mail/127.0.0.1"
  },
  "seed": [
    {
      "folder": "127.0.0.1/Inbox",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab folders mike\nDate: Thu, 01 Jan 2026 10:00:00 +0000\nMessage-ID: <ft-mike@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of ft-mike.\n"
      ]
    },
    {
      "folder": "127.0.0.1/Trash",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab folders november\nDate: Thu, 02 Jan 2026 10:00:00 +0000\nMessage-ID: <ft-november@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of ft-november.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab folders oscar\nDate: Thu, 03 Jan 2026 10:00:00 +0000\nMessage-ID: <ft-oscar@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of ft-oscar.\n"
      ]
    },
    {
      "folder": "Local Folders/Trash",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab folders papa\nDate: Thu, 04 Jan 2026 10:00:00 +0000\nMessage-ID: <ft-papa@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of ft-papa.\n"
      ]
    },
    {
      "folder": "Local Folders/Junk",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab folders quebec\nDate: Thu, 05 Jan 2026 10:00:00 +0000\nMessage-ID: <ft-quebec@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of ft-quebec.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab folders romeo\nDate: Thu, 06 Jan 2026 10:00:00 +0000\nMessage-ID: <ft-romeo@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of ft-romeo.\n"
      ]
    }
  ],
  "steps": [
    {
      "id": "accounts",
      "tool": "listAccounts",
      "timeout": 30,
      "arguments": {}
    },
    {
      "id": "index-trigger",
      "tool": "applyFilters",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      },
      "wait_after": 3,
      "note": "Seeded mbox files have no .msf summary; running the (empty) filter list over the folder makes Thunderbird parse it.",
      "retry": {
        "attempts": 10,
        "delay": 2
      }
    },
    {
      "id": "index-ready",
      "tool": "getMessage",
      "timeout": 30,
      "arguments": {
        "messageId": "ft-mike@example.com",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "bodyFormat": "text"
      },
      "retry": {
        "attempts": 12,
        "delay": 3
      }
    },
    {
      "id": "ptrash-ready",
      "tool": "getMessage",
      "timeout": 30,
      "arguments": {
        "messageId": "ft-november@example.com",
        "folderPath": "mailbox://lab@127.0.0.1/Trash",
