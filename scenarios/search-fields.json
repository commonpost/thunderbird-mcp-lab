      "type": "tool_ok",
      "step": "index-ready"
    },
    {
      "type": "tool_ok",
      "step": "archive-ready"
    },
    {
      "type": "tool_ok",
      "step": "um-state"
    },
    {
      "type": "tool_json_equals",
      "tool": "searchMessages",
      "path": "inputSchema.properties.fields.type",
      "equals": "array"
    },
    {
      "type": "tool_json_equals",
      "tool": "searchMessages",
      "path": "inputSchema.properties.fields.items.enum",
      "equals": [
        "date",
        "author",
        "recipients",
        "ccList",
        "subject",
        "read",
        "flagged",
        "tags",
        "preview",
        "dupLocations"
      ],
      "note": "The columns of a row, but id and folderPath, which are always returned."
    },
    {
      "type": "tool_json_equals",
      "tool": "getRecentMessages",
      "path": "inputSchema.properties.fields.type",
      "equals": "array"
    },
    {
      "type": "tool_json_equals",
      "tool": "getRecentMessages",
      "path": "inputSchema.properties.fields.items.enum",
      "equals": [
        "date",
        "author",
        "recipients",
        "ccList",
        "subject",
        "read",
        "flagged",
        "tags",
        "preview",
        "dupLocations"
