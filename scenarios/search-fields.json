        "daysBack": 100000,
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [
          "tags"
        ],
        "flaggedOnly": true
      }
    },
    {
      "id": "r-legacy",
      "tool": "getRecentMessages",
      "timeout": 60,
      "arguments": {
        "daysBack": 100000,
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [
          "subject"
        ],
        "format": "legacy"
      }
    },
    {
      "id": "r-unknown",
      "tool": "getRecentMessages",
      "timeout": 60,
      "arguments": {
        "daysBack": 100000,
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [
          "body"
        ]
      }
    }
  ],
  "checks": [
