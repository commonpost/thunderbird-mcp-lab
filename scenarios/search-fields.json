{
  "name": "search-fields",
  "description": "fields of searchMessages and getRecentMessages (new in 0.19.0) on four seeded POP3 messages (one flagged and tagged, one with a Cc, one with an attachment, one encrypted) and a copy of one of them in Archives. A row is cut to the asked columns plus id and folderPath, in the order the add-on writes them, in objects and in table format: one column, several, none, with a query, a page, a JSON string holding the list; the columns an option or a state adds stay (attachments with attachmentName, dupLocations when asked for, encrypted in getRecentMessages); the number of matches does not change. fields is refused with countOnly, groupBy and format legacy, and a name that is not a column (id included) or a value that is not a list is refused by the schema; without fields all of these work as before. The definition of the two tools (the enum of the columns). Not covered: the preview column (no row of the lab's seeded messages carries one, so there is nothing to cut) and mail that is not stored locally. Nothing is sent.",
  "prefs": {
    "mail.server.server2.directory-rel": "[ProfD]Mail/127.0.0.1"
  },
  "schema_watch": [
    "searchMessages",
    "getRecentMessages"
  ],
  "tools_dump": [
    "searchMessages",
    "getRecentMessages"
  ],
  "seed": [
    {
      "folder": "127.0.0.1/Inbox",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nCc: Carol Example <carol@example.com>\nSubject: SF first [sf-1]\nDate: Thu, 01 Jan 2026 10:00:00 +0000\nMessage-ID: <sf-1@example.com>\nMIME-Version: 1.0\nContent-Transfer-Encoding: 8bit\nContent-Type: text/plain; charset=UTF-8\n\nFirst body.\n",
        "From: Bob Example <bob@example.com>\nTo: Lab User <lab@example.test>\nSubject: SF second [sf-2]\nDate: Fri, 02 Jan 2026 10:00:00 +0000\nMessage-ID: <sf-2@example.com>\nMIME-Version: 1.0\nContent-Transfer-Encoding: 8bit\nContent-Type: text/plain; charset=UTF-8\n\nSecond body.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: SF attached [sf-3]\nDate: Sat, 03 Jan 2026 10:00:00 +0000\nMessage-ID: <sf-3@example.com>\nMIME-Version: 1.0\nContent-Type: multipart/mixed; boundary=\"sf3\"\n\n--sf3\nContent-Type: text/plain; charset=UTF-8\n\nThird body with a file.\n\n--sf3\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: base64\nContent-Disposition: attachment; filename=\"sf-notes.txt\"\n\nSGVsbG8gZnJvbSB0aGUgbGFiLgo=\n\n--sf3--\n",
        "From: Bob Example <bob@example.com>\nTo: Lab User <lab@example.test>\nSubject: SF secret [sf-enc]\nDate: Sun, 04 Jan 2026 10:00:00 +0000\nMessage-ID: <sf-enc@example.com>\nMIME-Version: 1.0\nContent-Type: multipart/encrypted; protocol=\"application/pgp-encrypted\"; boundary=\"enc\"\n\n--enc\nContent-Type: application/pgp-encrypted\n\nVersion: 1\n\n--enc\nContent-Type: application/octet-stream; name=\"encrypted.asc\"\n\n-----BEGIN PGP MESSAGE-----\n\nhQEMA0000000000000\n=abcd\n-----END PGP MESSAGE-----\n\n--enc--\n"
      ]
    },
    {
      "folder": "Local Folders/Archives",
      "messages": [
        "From: Bob Example <bob@example.com>\nTo: Lab User <lab@example.test>\nSubject: SF second [sf-2]\nDate: Fri, 02 Jan 2026 10:00:00 +0000\nMessage-ID: <sf-2@example.com>\nMIME-Version: 1.0\nContent-Transfer-Encoding: 8bit\nContent-Type: text/plain; charset=UTF-8\n\nSecond body.\n"
      ]
    }
  ],
  "steps": [
    {
      "id": "index-trigger",
      "tool": "applyFilters",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      },
      "retry": {
        "attempts": 10,
        "delay": 2
      },
      "wait_after": 3,
      "note": "Seeded mbox files have no .msf summary; running the (empty) filter list over the folder makes Thunderbird parse it."
    },
    {
      "id": "index-ready",
      "tool": "getMessage",
      "timeout": 30,
      "arguments": {
        "messageId": "sf-1@example.com",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "bodyFormat": "text"
      },
      "retry": {
        "attempts": 12,
        "delay": 3
      }
    },
    {
      "id": "archive-ready",
      "tool": "getMessage",
      "timeout": 30,
      "arguments": {
        "messageId": "sf-2@example.com",
        "folderPath": "mailbox://nobody@Local%20Folders/Archives",
        "bodyFormat": "text"
      },
      "retry": {
        "attempts": 12,
        "delay": 3
      }
    },
    {
      "id": "um-state",
      "tool": "updateMessage",
      "timeout": 30,
      "arguments": {
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "messageId": "sf-1@example.com",
        "flagged": true,
        "addTags": [
          "lab-tag"
        ]
      }
    },
    {
      "id": "s-full",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      }
    },
    {
      "id": "s-subject",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [
          "subject"
        ]
      }
    },
    {
      "id": "s-several",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [
          "author",
          "recipients",
          "ccList",
          "date",
          "read",
          "flagged",
          "tags"
        ]
      }
    },
    {
      "id": "s-empty",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": []
      }
    },
    {
      "id": "s-json-string",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": "[\"subject\"]"
      },
      "note": "A JSON string holding the list is accepted, as for the other array arguments."
    },
    {
      "id": "s-table",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [
          "subject",
          "date"
        ],
        "format": "table"
      }
    },
    {
      "id": "s-table-empty",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [],
        "format": "table"
      }
    },
    {
      "id": "s-query",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "from:alice",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [
          "author"
        ]
      }
    },
    {
      "id": "s-paged",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [
          "subject"
        ],
        "maxResults": 2,
        "offset": 1
      }
    },
    {
      "id": "s-attach",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "attachmentName": "sf-notes",
        "fields": [
          "subject"
        ]
      }
    },
    {
      "id": "s-attach-table",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "attachmentName": "sf-notes",
        "fields": [
          "subject"
        ],
        "format": "table"
      }
    },
    {
      "id": "s-dup-cut",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "sf-2",
        "fields": [
          "subject"
        ]
      }
    },
    {
      "id": "s-dup-kept",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "sf-2",
        "fields": [
          "dupLocations"
        ]
      }
    },
    {
      "id": "s-dup-full",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "sf-2"
      }
    },
    {
      "id": "s-count",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "countOnly": true
      }
    },
    {
      "id": "s-group",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "groupBy": "sender"
      }
    },
    {
      "id": "e-count",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [
          "subject"
        ],
        "countOnly": true
      }
    },
    {
      "id": "e-group",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "fields": [
          "subject"
        ],
        "groupBy": "sender"
      }
    },
