{
  "name": "delete-task",
  "description": "deleteTask (new in 0.19.0) in an ics calendar seeded with an event and four tasks (one completed, one that recurs weekly). A task is deleted by taskId and calendarId with no review dialog and with the default blockSkipReview, and it is gone from listTasks and from the .ics file Thunderbird wrote, while the other tasks stay; a recurring task goes with its whole series and a warning. The id of an event is refused (Task not found) by deleteTask and by updateTask, and the event stays unchanged in listEvents and in the file. Errors: a task already deleted, an unknown task, a task looked up in another calendar, an unknown calendar, a read-only calendar (its task stays), no taskId, no calendarId. The definition of the tool in tools/list (required parameters, destructive, not read-only) and the pointer from updateTask. The tasks deleted here are seeded ones. The tool disabled by an earlier restriction is covered by new-tools-disabled.json. Nothing is sent.",
  "prefs": {
    "calendar.list.sortOrder": "labstore labdel labro",
    "calendar.registry.labstore.type": "storage",
    "calendar.registry.labstore.uri": "moz-storage-calendar://",
    "calendar.registry.labstore.name": "Lab store",
    "calendar.registry.labstore.disabled": false,
    "calendar.registry.labstore.calendar-main-in-composite": true,
    "calendar.registry.labdel.type": "ics",
    "calendar.registry.labdel.uri": "file:///lab/profile/Mail/labdel/msgFilterRules.dat",
    "calendar.registry.labdel.name": "Lab delete",
    "calendar.registry.labdel.disabled": false,
    "calendar.registry.labdel.calendar-main-in-composite": true,
    "calendar.registry.labro.type": "ics",
    "calendar.registry.labro.uri": "file:///lab/profile/Mail/labrodel/msgFilterRules.dat",
    "calendar.registry.labro.name": "Lab read-only",
    "calendar.registry.labro.disabled": false,
    "calendar.registry.labro.calendar-main-in-composite": true,
    "calendar.registry.labro.readOnly": true
  },
  "seed_files": [
    {
      "path": "Mail/labdel/msgFilterRules.dat",
      "content": "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Lab//DeleteTask//EN\nBEGIN:VEVENT\nUID:lab-del-evt-1@example.test\nDTSTAMP:20261101T120000Z\nDTSTART:20261215T150000Z\nDTEND:20261215T160000Z\nSUMMARY:Seeded event one\nLOCATION:Room 1\nDESCRIPTION:Event description\nEND:VEVENT\nBEGIN:VTODO\nUID:lab-del-todo-1@example.test\nDTSTAMP:20261101T120000Z\nSUMMARY:Seeded task one\nDUE:20261220T120000Z\nPRIORITY:5\nEND:VTODO\nBEGIN:VTODO\nUID:lab-del-todo-2@example.test\nDTSTAMP:20261101T120000Z\nSUMMARY:Seeded task two\nDUE:20261225T120000Z\nEND:VTODO\nBEGIN:VTODO\nUID:lab-del-todo-3@example.test\nDTSTAMP:20261101T120000Z\nSUMMARY:Seeded task three\nDUE:20261230T120000Z\nSTATUS:COMPLETED\nPERCENT-COMPLETE:100\nEND:VTODO\nBEGIN:VTODO\nUID:lab-del-weekly@example.test\nDTSTAMP:20261101T120000Z\nDTSTART:20261201T100000Z\nDUE:20261201T110000Z\nSUMMARY:Seeded weekly task\nRRULE:FREQ=WEEKLY;COUNT=4\nEND:VTODO\nEND:VCALENDAR\n"
    },
    {
      "path": "Mail/labrodel/msgFilterRules.dat",
      "content": "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Lab//DeleteTask//EN\nBEGIN:VTODO\nUID:lab-del-ro-todo@example.test\nDTSTAMP:20261101T120000Z\nSUMMARY:Read only task\nDUE:20261222T120000Z\nEND:VTODO\nEND:VCALENDAR\n"
    }
  ],
  "schema_watch": [
    "deleteTask"
  ],
  "tools_dump": [
    "deleteTask",
    "updateTask"
  ],
  "steps": [
    {
      "id": "cals",
      "tool": "listCalendars",
      "timeout": 30,
      "arguments": {}
    },
    {
      "id": "lt-before",
      "tool": "listTasks",
      "timeout": 30,
      "arguments": {
        "calendarId": "labdel"
      },
      "retry": {
        "attempts": 10,
        "delay": 2
      },
      "note": "The ics calendars load asynchronously; retried only on error."
    },
    {
      "id": "dt-one",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "taskId": "lab-del-todo-1@example.test",
        "calendarId": "labdel"
      }
    },
    {
      "id": "lt-after",
      "tool": "listTasks",
      "timeout": 30,
      "arguments": {
        "calendarId": "labdel"
      }
    },
    {
      "id": "dt-again",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "taskId": "lab-del-todo-1@example.test",
        "calendarId": "labdel"
      }
    },
    {
      "id": "dt-done-task",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "taskId": "lab-del-todo-3@example.test",
        "calendarId": "labdel"
      },
      "note": "A completed task is deleted like any other."
    },
    {
      "id": "dt-weekly",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "taskId": "lab-del-weekly@example.test",
        "calendarId": "labdel"
      }
    },
    {
      "id": "dt-event",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "taskId": "lab-del-evt-1@example.test",
        "calendarId": "labdel"
      }
    },
    {
      "id": "ut-event",
      "tool": "updateTask",
      "timeout": 30,
      "arguments": {
        "taskId": "lab-del-evt-1@example.test",
        "calendarId": "labdel",
        "title": "Renamed by updateTask",
        "priority": 1
      }
    },
    {
      "id": "le-after",
      "tool": "listEvents",
      "timeout": 30,
      "arguments": {
        "startDate": "2026-12-01",
        "endDate": "2026-12-31",
        "calendarId": "labdel"
      }
    },
    {
      "id": "e-no-task",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "calendarId": "labdel"
      }
    },
    {
      "id": "e-no-calendar",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "taskId": "lab-del-todo-2@example.test"
      }
    },
    {
      "id": "e-calendar",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "taskId": "lab-del-todo-2@example.test",
        "calendarId": "no-such-calendar"
      }
    },
    {
      "id": "e-unknown",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "taskId": "no-such-task",
        "calendarId": "labdel"
      }
    },
    {
      "id": "e-other-calendar",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "taskId": "lab-del-todo-2@example.test",
        "calendarId": "labstore"
      }
    },
    {
      "id": "e-readonly",
      "tool": "deleteTask",
      "timeout": 30,
      "arguments": {
        "taskId": "lab-del-ro-todo@example.test",
        "calendarId": "labro"
      }
    },
    {
      "id": "lt-final",
      "tool": "listTasks",
      "timeout": 30,
      "arguments": {
        "calendarId": "labdel"
      }
    },
    {
      "id": "lt-ro",
      "tool": "listTasks",
      "timeout": 30,
      "arguments": {
        "calendarId": "labro"
      }
    }
  ],
