{
  "name": "read-only-mode",
  "description": "With COMMONPOST_MCP_READ_ONLY=1 for the bridge, tools/list keeps only the 14 tools that change nothing (getMessage and getMessages without saveAttachments) and drops the 27 others; the read tools work; getMessage with saveAttachments, and the write tools and an unknown tool called anyway, are refused by the bridge before they reach Thunderbird, and nothing is saved, sent, created or deleted.",
  "bridge_env": {
    "COMMONPOST_MCP_READ_ONLY": "1"
  },
  "tools_dump": [
    "getMessage",
    "getMessages"
  ],
  "steps": [
    {
      "id": "accounts",
      "tool": "listAccounts",
      "arguments": {},
      "timeout": 60
    },
    {
      "id": "folders",
      "tool": "listFolders",
      "arguments": {},
      "timeout": 60
    },
    {
      "id": "recent",
      "tool": "getRecentMessages",
      "arguments": {
        "maxResults": 5
      },
      "timeout": 60
    },
    {
      "id": "contacts",
      "tool": "searchContacts",
      "arguments": {
        "query": "example"
      },
      "timeout": 60
    },
    {
      "id": "calendars",
      "tool": "listCalendars",
      "arguments": {},
      "timeout": 60
    },
    {
      "id": "get-save",
      "tool": "getMessage",
      "arguments": {
        "messageId": "ro-none@example.test",
        "folderPath": "mailbox://nobody@Local%20Folders/Inbox",
        "saveAttachments": true
      },
      "note": "Kept in read-only mode, but not with saveAttachments, its only write.",
      "timeout": 60
    },
    {
      "id": "draft",
      "tool": "saveDraft",
      "force_call": true,
      "arguments": {
        "to": "recipient@example.com",
        "subject": "Lab read-only [ro-draft]",
        "body": "Must not be saved.\n"
      },
      "timeout": 60
    },
    {
      "id": "send",
      "tool": "sendMail",
      "force_call": true,
      "arguments": {
        "to": "recipient@example.com",
        "subject": "Lab read-only [ro-send]",
        "body": "Must not be sent.\n",
        "skipReview": true
      },
      "timeout": 60
    },
    {
      "id": "folder",
      "tool": "createFolder",
      "force_call": true,
      "arguments": {
        "parentFolderPath": "mailbox://nobody@Local%20Folders",
        "name": "lab-read-only-folder"
      },
      "timeout": 60
    },
    {
      "id": "contact",
      "tool": "createContact",
      "force_call": true,
      "arguments": {
        "email": "ro-contact@example.com",
        "displayName": "Read Only Contact"
      },
      "timeout": 60
    },
    {
      "id": "filter",
      "tool": "createFilter",
      "force_call": true,
      "arguments": {
        "accountId": "account2",
        "name": "lab-read-only-filter",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "ro"
          }
        ],
        "actions": [
          {
            "type": "markRead"
          }
        ]
      },
      "timeout": 60
    },
    {
      "id": "delete",
      "tool": "deleteMessages",
      "force_call": true,
      "arguments": {
        "messageIds": [
          "ro-none@example.test"
        ],
        "folderPath": "mailbox://nobody@Local%20Folders/Inbox"
      },
      "timeout": 60
    },
    {
      "id": "trash",
      "tool": "emptyTrash",
      "force_call": true,
      "arguments": {
        "accountId": "account2"
      },
      "timeout": 60
    },
    {
      "id": "task",
      "tool": "deleteTask",
      "force_call": true,
      "arguments": {
        "taskId": "ro-none@example.test",
        "calendarId": "none"
      },
      "timeout": 60
    },
    {
      "id": "unknown",
      "tool": "labNoSuchTool",
      "force_call": true,
      "arguments": {},
      "note": "A name the add-on does not list is refused too.",
      "timeout": 60
    },
    {
      "id": "folders-after",
      "tool": "listFolders",
      "arguments": {},
      "timeout": 60
    },
    {
      "id": "contacts-after",
      "tool": "searchContacts",
      "arguments": {
        "query": "ro-contact"
      },
      "timeout": 60
    },
    {
      "id": "filters-after",
      "tool": "listFilters",
      "arguments": {
        "accountId": "account2"
      },
      "timeout": 60
    }
  ],
  "checks": [
