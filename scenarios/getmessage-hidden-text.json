{
  "name": "getmessage-hidden-text",
  "description": "getMessage removes from an HTML body the text a reader does not see, and keeps the text a reader sees, in the markdown and text formats. An MJML layout, whose column wrappers have font-size:0px and whose text sets its own size, is returned whole. Small but readable sizes and opacities (0.875rem, 0.9em, opacity:0.8) are kept; a child that sets its own font-size or visibility:visible is shown. Removed: tiny and zero sizes, an opacity product below 0.1, an override Gecko drops (display:block\\9, opacity:1.), a hidden child of <pre>, and the URL of a link whose text is hidden. The html format returns the body unchanged. Inline styles only: rules in <style> blocks are not covered here.",
  "prefs": {
    "mail.server.server2.directory-rel": "[ProfD]Mail/127.0.0.1"
  },
  "seed": [
    {
      "folder": "127.0.0.1/Inbox",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: HT mjml [ht-mjml]\nDate: Thu, 01 Jan 2026 10:00:00 +0000\nMessage-ID: <ht-mjml@example.com>\nMIME-Version: 1.0\nContent-Type: text/html; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\n<!doctype html><html><body style=\"word-spacing:normal;\"><div style=\"\">\n<div style=\"margin:0px auto;max-width:600px;\"><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;\"><tbody><tr><td style=\"direction:ltr;font-size:0px;padding:20px 0;text-align:center;\">\n<div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"vertical-align:top;\" width=\"100%\"><tbody>\n<tr><td align=\"left\" style=\"font-size:0px;padding:10px 25px;word-break:break-word;\"><div style=\"font-family:Ubuntu, Helvetica, Arial, sans-serif;font-size:13px;line-height:1;text-align:left;color:#000000;\">VISIBLE-MJML-COLUMN Welcome to the newsletter</div></td></tr>\n<tr><td align=\"left\" style=\"font-size:0px;padding:10px 25px;word-break:break-word;\"><div style=\"font-family:Ubuntu, Helvetica, Arial, sans-serif;font:14px/1.5 Ubuntu, Arial;text-align:left;color:#555555;\">VISIBLE-MJML-SHORTHAND Read the full story</div></td></tr>\n</tbody></table></div></td></tr></tbody></table></div></div>\n</body></html>",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: HT styles [ht-styles]\nDate: Thu, 01 Jan 2026 10:00:00 +0000\nMessage-ID: <ht-styles@example.com>\nMIME-Version: 1.0\nContent-Type: text/html; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\n<html><body>\n<p>VISIBLE-START</p>\n<p><span style=\"font-size:0.875rem\">VISIBLE-REM</span> <span style=\"font-size: 0.9em\">VISIBLE-EM</span> <span style=\"opacity:0.8\">VISIBLE-OPACITY</span></p>\n<div style=\"font-size:0\"><span style=\"font-size:13px\">VISIBLE-RESIZED</span></div>\n<div style=\"visibility:hidden\">LEAK-VISIBILITY <span style=\"visibility:visible\">VISIBLE-VISIBILITY</span></div>\n<p><span style=\"display:none;display:block\">VISIBLE-OVERRIDE</span></p>\n<p><span style=\"font-size:1px\">LEAK-TINY</span><span style=\"font-size:0px\">LEAK-ZERO</span></p>\n<div style=\"opacity:0.3\"><div style=\"opacity:0.3\">LEAK-OPACITY-PRODUCT</div></div>\n<p><span style=\"display:none;display:block\\9\">LEAK-DROPPED-OVERRIDE</span><span style=\"opacity:0;opacity:1.\">LEAK-DROPPED-OPACITY</span></p>\n<pre>PRE-A<span style=\"display:none\">LEAK-PRE</span>PRE-B</pre>\n<div style=\"font-size:0\"><a href=\"https://example.com/LEAK-LINK-URL\">read</a></div>\n<p>VISIBLE-END</p>\n</body></html>"
      ]
    }
  ],
  "steps": [
    {
      "id": "index-trigger",
      "tool": "applyFilters",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      },
      "wait_after": 3,
      "note": "Seeded mbox files have no .msf summary; running the (empty) filter list over the folder makes Thunderbird parse it.",
      "retry": {
        "attempts": 10,
        "delay": 2
      }
    },
    {
      "id": "index-ready",
      "tool": "getMessage",
      "timeout": 30,
      "arguments": {
        "messageId": "ht-mjml@example.com",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "bodyFormat": "html"
      },
      "retry": {
        "attempts": 12,
        "delay": 3
      }
    },
    {
      "id": "mjml-markdown",
      "tool": "getMessage",
      "timeout": 60,
      "arguments": {
        "messageId": "ht-mjml@example.com",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "bodyFormat": "markdown"
      }
    },
    {
      "id": "mjml-text",
      "tool": "getMessage",
      "timeout": 60,
      "arguments": {
        "messageId": "ht-mjml@example.com",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "bodyFormat": "text"
      }
    },
    {
      "id": "styles-markdown",
      "tool": "getMessage",
      "timeout": 60,
      "arguments": {
        "messageId": "ht-styles@example.com",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "bodyFormat": "markdown"
