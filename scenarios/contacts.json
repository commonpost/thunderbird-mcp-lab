{
  "name": "contacts",
  "description": "createContact and searchContacts on the Personal Address Book: a contact with every field, one with several addresses of different types, one created in an explicitly named address book, a phone-only contact (its display name is the number) and one with a birthday without a year. searchContacts must find them by name, organization, a secondary address, a domain, several words (all must match) and in any case, return the table format, cut at maxResults with hasMore, and return nothing for an unknown word. The main errors of createContact, searchContacts, getContact, updateContact and deleteContact are checked (nothing to create, bad birthday, primary address mismatch, unknown address book, bad types, empty or unknown contact id) and a refused createContact must not create anything. Limit: a contact id is generated by Thunderbird and a scenario cannot pass a response value to a later step, so the success paths of getContact, updateContact and deleteContact cannot be driven here; only their refusals are checked. Nothing is sent.",
  "steps": [
    {
      "id": "cc-full",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {
        "email": "zed@example.com",
        "displayName": "Zed Example",
        "firstName": "Zed",
        "lastName": "Example",
        "organization": "Lab Org",
        "title": "Tester",
        "note": "First line\nSecond line",
        "birthday": "1990-05-17",
        "phones": [
          {
            "type": "work",
            "number": "555-0100"
          },
          {
            "type": "mobile",
            "number": "555-0101"
          }
        ],
        "addresses": [
          {
            "type": "work",
            "street": "1 Test St",
            "city": "Testville",
            "postalCode": "T1T 1T1",
            "country": "Testland"
          }
        ]
      }
    },
    {
      "id": "cc-multi",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {
        "emails": [
          {
            "address": "ann@example.com",
            "type": "work",
            "primary": true
          },
          {
            "address": "ann.home@example.org",
            "type": "home"
          }
        ],
        "displayName": "Ann Example",
        "lastName": "Example",
        "organization": "Acme Lab"
      }
    },
    {
      "id": "cc-book",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {
        "email": "bob@example.net",
        "displayName": "Bob Sample",
        "addressBookId": "jsaddrbook://abook.sqlite"
      }
    },
    {
      "id": "cc-phone",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {
        "phones": [
          {
            "type": "mobile",
            "number": "555-0199"
          }
        ]
      }
    },
    {
      "id": "cc-bday",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {
        "email": "dee@example.com",
        "displayName": "Dee Yearless",
        "birthday": "--03-09"
      }
    },
    {
      "id": "sc-zed",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "zed"
      }
    },
    {
      "id": "sc-case-words",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "ZED lab"
      }
    },
    {
      "id": "sc-org",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "acme"
      }
    },
    {
      "id": "sc-second",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "ann.home@example.org"
      }
    },
    {
      "id": "sc-domain",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "@example.net"
      }
    },
    {
      "id": "sc-words",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "ann example"
      }
    },
    {
      "id": "sc-bday",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "yearless"
      }
    },
    {
      "id": "sc-none",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "no-such-contact"
      }
    },
    {
      "id": "sc-table",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "zed",
        "format": "table"
      }
    },
    {
      "id": "sc-limit",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "example",
        "maxResults": 2
      }
    },
    {
      "id": "sc-all",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": ""
      }
    },
    {
      "id": "e-empty",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {}
    },
    {
      "id": "e-bday",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {
        "email": "invalid-contact@example.com",
        "birthday": "1990-13-45"
      }
    },
    {
      "id": "e-mismatch",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {
        "email": "invalid-contact@example.com",
        "emails": [
          {
            "address": "other@example.com"
          }
        ]
      }
    },
    {
      "id": "e-book",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {
        "email": "invalid-contact@example.com",
        "addressBookId": "no-such-book"
      }
    },
    {
      "id": "e-phone-type",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {
        "phones": [
          {
            "type": "bogus",
            "number": "1"
          }
        ]
      }
    },
    {
      "id": "e-name-type",
      "tool": "createContact",
      "timeout": 30,
      "arguments": {
        "displayName": 5
      }
    },
    {
      "id": "e-get-unknown",
      "tool": "getContact",
      "timeout": 30,
      "arguments": {
        "contactId": "no-such-contact-id"
      }
    },
    {
      "id": "e-get-empty",
      "tool": "getContact",
      "timeout": 30,
      "arguments": {
        "contactId": ""
      }
    },
    {
      "id": "e-update-unknown",
      "tool": "updateContact",
      "timeout": 30,
      "arguments": {
        "contactId": "no-such-contact-id",
        "displayName": "Nobody"
      }
    },
    {
      "id": "e-update-empty",
      "tool": "updateContact",
      "timeout": 30,
      "arguments": {
        "contactId": ""
      }
    },
    {
      "id": "e-delete-unknown",
      "tool": "deleteContact",
      "timeout": 30,
      "arguments": {
        "contactId": "no-such-contact-id"
      }
    },
    {
      "id": "e-delete-empty",
      "tool": "deleteContact",
      "timeout": 30,
      "arguments": {
        "contactId": ""
      }
    },
    {
      "id": "e-search-query",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {}
    },
    {
      "id": "sc-after",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": "invalid-contact@example.com"
      }
    },
    {
      "id": "sc-after-all",
      "tool": "searchContacts",
      "timeout": 30,
      "arguments": {
        "query": ""
      }
    }
  ],
  "checks": [
    {
      "type": "tool_ok",
      "step": "cc-full"
    },
    {
      "type": "tool_result_contains",
      "step": "cc-full",
      "contains": "\"success\":true"
    },
    {
      "type": "tool_result_contains",
      "step": "cc-full",
      "contains": "\"email\":\"zed@example.com\""
    },
    {
      "type": "tool_result_contains",
      "step": "cc-full",
      "contains": "\"displayName\":\"Zed Example\""
    },
    {
      "type": "tool_result_contains",
      "step": "cc-full",
      "contains": "\"addressBook\":\"Personal Address Book\""
    },
    {
      "type": "tool_ok",
      "step": "cc-multi"
    },
    {
      "type": "tool_result_contains",
      "step": "cc-multi",
      "contains": "\"emails\":[{\"address\":\"ann@example.com\",\"type\":\"work\",\"primary\":true},{\"address\":\"ann.home@example.org\",\"type\":\"home\"}]"
    },
    {
      "type": "tool_ok",
      "step": "cc-book"
    },
    {
      "type": "tool_result_contains",
      "step": "cc-book",
      "contains": "\"displayName\":\"Bob Sample\""
    },
    {
      "type": "tool_ok",
      "step": "cc-phone"
    },
    {
      "type": "tool_result_contains",
      "step": "cc-phone",
      "contains": "\"displayName\":\"555-0199\"",
      "note": "a contact with only a phone number is named after the number"
    },
    {
      "type": "tool_ok",
      "step": "cc-bday"
    },
    {
      "type": "tool_ok",
      "step": "sc-zed"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "\"displayName\":\"Zed Example\",\"email\":\"zed@example.com\""
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "\"firstName\":\"Zed\",\"lastName\":\"Example\""
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "\"phones\":[{\"type\":\"work\",\"number\":\"555-0100\"},{\"type\":\"mobile\",\"number\":\"555-0101\"}]"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "\"addresses\":[{\"type\":\"work\",\"street\":\"1 Test St\",\"city\":\"Testville\",\"postalCode\":\"T1T 1T1\",\"country\":\"Testland\"}]"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "\"organization\":\"Lab Org\""
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "Tester"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "First line\\nSecond line",
      "note": "the multi-line note is kept"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "\"birthday\":\"1990-05-17\""
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "\"addressBookId\":\"jsaddrbook://abook.sqlite\""
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "Ann Example",
      "present": false
    },
    {
      "type": "tool_result_contains",
      "step": "sc-zed",
      "contains": "Bob Sample",
      "present": false
    },
    {
      "type": "tool_ok",
      "step": "sc-case-words"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-case-words",
      "contains": "Zed Example",
      "note": "case-insensitive; the words match different fields (name, organization)"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-case-words",
      "contains": "Ann Example",
      "present": false
    },
    {
      "type": "tool_result_contains",
      "step": "sc-org",
      "contains": "Ann Example"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-org",
      "contains": "\"organization\":\"Acme Lab\""
    },
    {
      "type": "tool_result_contains",
      "step": "sc-org",
      "contains": "Zed Example",
      "present": false
    },
    {
      "type": "tool_result_contains",
      "step": "sc-second",
      "contains": "Ann Example",
      "note": "found by the secondary address, not only the primary one"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-domain",
      "contains": "bob@example.net"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-domain",
      "contains": "Ann Example",
      "present": false
    },
    {
      "type": "tool_result_contains",
      "step": "sc-words",
      "contains": "Ann Example"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-words",
      "contains": "Zed Example",
      "present": false,
      "note": "every word must match"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-bday",
      "contains": "\"birthday\":\"--03-09\"",
      "note": "a birthday without a year comes back without one"
    },
    {
      "type": "tool_ok",
      "step": "sc-none"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-none",
      "contains": "[]"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-none",
      "contains": "Zed Example",
      "present": false
    },
    {
      "type": "tool_ok",
      "step": "sc-table"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-table",
      "contains": "\"contacts\":{\"columns\":["
    },
    {
      "type": "tool_result_contains",
      "step": "sc-table",
      "contains": "Zed Example"
    },
    {
      "type": "tool_ok",
      "step": "sc-limit"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-limit",
      "contains": "\"hasMore\":true"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-limit",
      "contains": "Results limited to 2"
    },
    {
      "type": "tool_ok",
      "step": "sc-all"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-all",
      "contains": "Zed Example"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-all",
      "contains": "Ann Example"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-all",
      "contains": "Bob Sample"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-all",
      "contains": "555-0199"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-all",
      "contains": "Dee Yearless"
    },
    {
      "type": "tool_error_contains",
      "step": "e-empty",
      "contains": "At least one non-empty contact field is required"
    },
    {
      "type": "tool_error_contains",
      "step": "e-bday",
      "contains": "birthday must be YYYY-MM-DD or --MM-DD with a valid calendar date"
    },
    {
      "type": "tool_error_contains",
      "step": "e-mismatch",
      "contains": "email must match the primary address of emails"
    },
    {
      "type": "tool_error_contains",
      "step": "e-book",
      "contains": "Address book not found: no-such-book"
    },
    {
      "type": "tool_error_contains",
      "step": "e-phone-type",
      "contains": "phones[0].type"
    },
    {
      "type": "tool_error_contains",
      "step": "e-name-type",
      "contains": "Parameter 'displayName' must be string"
    },
    {
      "type": "tool_error_contains",
      "step": "e-get-unknown",
      "contains": "Contact not found: no-such-contact-id"
    },
    {
      "type": "tool_error_contains",
      "step": "e-get-empty",
      "contains": "contactId must be a non-empty string"
    },
    {
      "type": "tool_error_contains",
      "step": "e-update-unknown",
      "contains": "Contact not found: no-such-contact-id"
    },
    {
      "type": "tool_error_contains",
      "step": "e-update-empty",
      "contains": "contactId must be a non-empty string"
    },
    {
      "type": "tool_error_contains",
      "step": "e-delete-unknown",
      "contains": "Contact not found: no-such-contact-id"
    },
    {
      "type": "tool_error_contains",
      "step": "e-delete-empty",
      "contains": "contactId must be a non-empty string"
    },
    {
      "type": "tool_error_contains",
      "step": "e-search-query",
      "contains": "Missing required parameter: query"
    },
    {
      "type": "tool_ok",
      "step": "sc-after"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-after",
      "contains": "[]",
      "note": "the refused createContact calls created nothing"
    },
    {
      "type": "tool_ok",
      "step": "sc-after-all"
    },
    {
      "type": "tool_result_contains",
      "step": "sc-after-all",
      "contains": "invalid-contact",
      "present": false
    },
    {
      "type": "mailpit_total",
      "equals": 0
    }
  ]
}
