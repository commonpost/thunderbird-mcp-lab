{
  "name": "security-special-folders",
  "description": "Thunderbird's special folders stay as they are through MCP (GHSA-whwf-gghm-mwx9, fixed in 0.18.1): the Trash, Inbox, Junk, Templates and Drafts folders are not renamed, moved or deleted, and their messages stay; no top-level folder is created or renamed with a special folder's name; nothing is created or moved into Templates; an ordinary folder is still created, renamed and deleted.",
  "prefs": {
    "mail.server.server2.directory-rel": "[ProfD]Mail/127.0.0.1"
  },
  "seed": [
    {
      "folder": "127.0.0.1/Inbox",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab folders mike\nDate: Thu, 01 Jan 2026 10:00:00 +0000\nMessage-ID: <ft-mike@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of ft-mike.\n"
