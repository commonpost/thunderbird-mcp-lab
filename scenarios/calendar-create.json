{
  "name": "calendar-create",
  "description": "createEvent with skipReview (the setting blockSkipReview is turned off for this scenario) in an empty ics calendar, read back with listEvents and in the .ics file Thunderbird wrote: every field (location, description, status, showAs free, categories, online meeting), an upper-case status, all-day events (one day, a same-day end, an end day after the start, which is the last day of the event), the default calendar when none is named. Errors: bad dates, an end that is not after the start (timed and all-day), unknown, read-only and disabled calendars, a status out of the list, a negative reminder, no title. The review dialog of createEvent is covered by calendar-reminders.json, the refusal of skipReview by security-calendar-skipreview-blocked.json. Nothing is sent.",
  "prefs": {
    "extensions.commonpost-mcp.blockSkipReview": false,
    "calendar.list.sortOrder": "labstore labnew labro labdis",
    "calendar.registry.labstore.type": "storage",
    "calendar.registry.labstore.uri": "moz-storage-calendar://",
    "calendar.registry.labstore.name": "Lab store",
    "calendar.registry.labstore.disabled": false,
    "calendar.registry.labstore.calendar-main-in-composite": true,
    "calendar.registry.labnew.type": "ics",
    "calendar.registry.labnew.uri": "file:///lab/profile/Mail/labnew/msgFilterRules.dat",
    "calendar.registry.labnew.name": "Lab new",
    "calendar.registry.labnew.disabled": false,
    "calendar.registry.labnew.calendar-main-in-composite": true,
    "calendar.registry.labro.type": "ics",
    "calendar.registry.labro.uri": "file:///lab/profile/Mail/labro/msgFilterRules.dat",
    "calendar.registry.labro.name": "Lab read-only",
    "calendar.registry.labro.disabled": false,
    "calendar.registry.labro.calendar-main-in-composite": true,
    "calendar.registry.labro.readOnly": true,
    "calendar.registry.labdis.type": "storage",
    "calendar.registry.labdis.uri": "moz-storage-calendar://",
    "calendar.registry.labdis.name": "Lab disabled",
    "calendar.registry.labdis.disabled": true,
    "calendar.registry.labdis.calendar-main-in-composite": true
  },
  "seed_files": [
    {
      "path": "Mail/labnew/msgFilterRules.dat",
      "content": "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Lab//Update//EN\r\nEND:VCALENDAR\r\n"
    },
    {
      "path": "Mail/labro/msgFilterRules.dat",
      "content": "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Lab//Update//EN\r\nBEGIN:VEVENT\r\nUID:lab-ro-event@example.test\r\nDTSTAMP:20261101T120000Z\r\nDTSTART:20261216T150000Z\r\nDTEND:20261216T160000Z\r\nSUMMARY:Read only event\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
    }
  ],
  "steps": [
    {
      "id": "cals",
      "tool": "listCalendars",
      "timeout": 30,
      "arguments": {}
    },
    {
      "id": "c-full",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "Created full",
        "startDate": "2026-12-10T14:00:00Z",
        "endDate": "2026-12-10T15:30:00Z",
        "location": "Lab room",
        "description": "Created by the lab",
        "status": "tentative",
        "showAs": "free",
        "categories": [
          "Work"
        ],
        "onlineMeeting": true
      }
    },
    {
      "id": "c-cancelled",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "Created cancelled",
        "startDate": "2026-12-09T14:00:00Z",
        "status": "CANCELLED",
        "showAs": "busy"
      }
    },
    {
      "id": "c-allday",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "Created allday",
        "startDate": "2026-12-11",
        "allDay": true
      }
    },
    {
      "id": "c-allday-range",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "Created allday range",
        "startDate": "2026-12-12",
        "endDate": "2026-12-14",
        "allDay": true
      },
      "note": "An all-day event from the 12th to the 14th: listEvents and updateEvent give the last day of an all-day event as endDate."
    },
    {
      "id": "c-allday-same",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "Created allday same",
        "startDate": "2026-12-16",
        "endDate": "2026-12-16",
        "allDay": true
      }
    },
    {
      "id": "c-default",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "title": "Created default calendar",
        "startDate": "2026-12-17T09:00:00Z",
        "skipReview": true
      },
      "note": "No calendarId: the first writable calendar that is turned on."
    },
    {
      "id": "e-badstart",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "x",
        "startDate": "garbage"
      }
    },
    {
      "id": "e-badend",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "x",
        "startDate": "2026-12-10T14:00:00Z",
        "endDate": "garbage"
      }
    },
    {
      "id": "e-endbefore",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "x",
        "startDate": "2026-12-10T14:00:00Z",
        "endDate": "2026-12-10T13:00:00Z"
      }
    },
    {
      "id": "e-endsame",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "x",
        "startDate": "2026-12-10T14:00:00Z",
        "endDate": "2026-12-10T14:00:00Z"
      }
    },
    {
      "id": "e-allday-before",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "x",
        "startDate": "2026-12-10",
        "endDate": "2026-12-08",
        "allDay": true
      }
    },
    {
      "id": "e-nocal",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "nope",
        "skipReview": true,
        "title": "x",
        "startDate": "2026-12-10T14:00:00Z"
      }
    },
    {
      "id": "e-readonly",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labro",
        "skipReview": true,
        "title": "x",
        "startDate": "2026-12-10T14:00:00Z"
      }
    },
    {
      "id": "e-disabled",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labdis",
        "skipReview": true,
        "title": "x",
        "startDate": "2026-12-10T14:00:00Z"
      }
    },
    {
      "id": "e-status",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "x",
        "startDate": "2026-12-10T14:00:00Z",
        "status": "maybe"
      }
    },
    {
      "id": "e-reminder",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "title": "x",
        "startDate": "2026-12-10T14:00:00Z",
        "reminders": [
          -1
        ]
      }
    },
    {
      "id": "e-title",
      "tool": "createEvent",
      "timeout": 30,
      "arguments": {
        "calendarId": "labnew",
        "skipReview": true,
        "startDate": "2026-12-10T14:00:00Z"
      }
    },
    {
      "id": "list-new",
      "tool": "listEvents",
      "timeout": 30,
      "arguments": {
        "startDate": "2026-12-01",
        "endDate": "2026-12-31",
        "calendarId": "labnew"
      },
      "retry": {
        "attempts": 10,
        "delay": 2
      },
      "wait_after": 3
    },
    {
      "id": "list-ro",
      "tool": "listEvents",
      "timeout": 30,
      "arguments": {
        "startDate": "2026-12-01",
        "endDate": "2026-12-31",
        "calendarId": "labro"
      },
      "retry": {
        "attempts": 10,
        "delay": 2
      }
    }
  ],
  "checks": [
    {
      "type": "tool_ok",
      "step": "cals"
    },
    {
      "type": "tool_result_contains",
      "step": "cals",
      "contains": "\"id\":\"labdis\",\"name\":\"Lab disabled\",\"type\":\"storage\",\"readOnly\":false,\"disabled\":true"
