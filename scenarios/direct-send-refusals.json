{
  "name": "direct-send-refusals",
  "description": "Direct sends refused without recipients or above the large-message size; a normal one goes out.",
  "prefs": {
    "mail.server.server2.directory-rel": "[ProfD]Mail/127.0.0.1",
    "extensions.commonpost-mcp.blockSkipReview": false,
    "mailnews.message_warning_size": 3000
  },
  "steps": [
    {
      "id": "no-recipient",
      "tool": "sendMail",
      "timeout": 90,
      "arguments": {
        "to": "",
        "subject": "Direct [r1]",
        "body": "x",
        "from": "lab@example.test",
        "skipReview": true
      }
    },
    {
      "id": "too-large",
      "tool": "sendMail",
      "timeout": 90,
      "arguments": {
        "to": "bob@example.com",
        "subject": "Direct [r2]",
        "body": "",
        "from": "lab@example.test",
        "skipReview": true
      }
    },
    {
      "id": "dry-large",
      "tool": "sendMail",
      "timeout": 60,
      "arguments": {
        "to": "bob@example.com",
        "subject": "Direct [r3]",
        "body": "",
        "from": "lab@example.test",
        "skipReview": true,
        "dryRun": true
      }
    },
    {
      "id": "ok",
      "tool": "sendMail",
      "timeout": 90,
      "wait_after": 3,
      "arguments": {
        "to": "bob@example.com",
        "subject": "Direct [r4]",
        "body": "small",
        "from": "lab@example.test",
        "skipReview": true
      }
    }
  ],
  "checks": [
    {
      "type": "tool_error_contains",
      "step": "no-recipient",
      "contains": "at least one recipient"
    },
    {
      "type": "tool_error_contains",
      "step": "too-large",
      "contains": "large-message size"
    },
    {
      "type": "tool_result_contains",
      "step": "dry-large",
      "contains": "large-message size"
    },
    {
      "type": "tool_result_contains",
      "step": "dry-large",
      "contains": "\"wouldSucceed\":false"
    },
    {
      "type": "tool_ok",
      "step": "ok"
    },
    {
      "type": "mailpit_total",
      "equals": 1
    },
    {
      "type": "mailpit_header_contains",
      "subject": "Direct [r4]",
      "header": "To",
      "contains": "bob@example.com"
    }
  ]
}
