      "tool": "updateMessage",
      "timeout": 30,
      "arguments": {
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "messageId": "mu-bravo@example.com",
        "addTags": [
          "$label1",
          "lab-x"
        ]
      }
    },
