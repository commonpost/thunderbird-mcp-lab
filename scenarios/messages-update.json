      "id": "um-reset",
      "tool": "updateMessage",
      "timeout": 30,
      "arguments": {
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "messageId": "mu-alpha@example.com",
        "read": false,
        "flagged": false
      }
    },
    {
      "id": "s-alpha-3",
      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "alpha",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      }
    },
    {
