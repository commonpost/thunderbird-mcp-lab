{
  "name": "messages-update",
  "description": "updateMessage on seeded messages of the POP3 Inbox: read, unread, flagged and unflagged (each change is read back with searchMessages, other messages stay untouched), tags added, removed and filtered on, one call on several messages with read, flag and tag together, a move to a new folder (the message leaves the Inbox, a message id that does not exist is reported in notFound), a move with tags (warning), and trash (the message lands in the account's Trash). The main errors are checked: messageId together with messageIds, nothing to update, moveTo together with trash, unknown message, unknown folder, a move into a Templates folder (refused through MCP), a tag list that is not an array, a missing folder. Nothing is sent.",
  "prefs": {
    "mail.server.server2.directory-rel": "[ProfD]Mail/127.0.0.1"
  },
  "seed": [
    {
      "folder": "127.0.0.1/Inbox",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab update alpha\nDate: Thu, 01 Jan 2026 10:00:00 +0000\nMessage-ID: <mu-alpha@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of mu-alpha.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab update bravo\nDate: Thu, 02 Jan 2026 10:00:00 +0000\nMessage-ID: <mu-bravo@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of mu-bravo.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab update charlie\nDate: Thu, 03 Jan 2026 10:00:00 +0000\nMessage-ID: <mu-charlie@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of mu-charlie.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab update delta\nDate: Thu, 04 Jan 2026 10:00:00 +0000\nMessage-ID: <mu-delta@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of mu-delta.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab update echo\nDate: Thu, 05 Jan 2026 10:00:00 +0000\nMessage-ID: <mu-echo@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of mu-echo.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab update foxtrot\nDate: Thu, 06 Jan 2026 10:00:00 +0000\nMessage-ID: <mu-foxtrot@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of mu-foxtrot.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab update golf\nDate: Thu, 07 Jan 2026 10:00:00 +0000\nMessage-ID: <mu-golf@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of mu-golf.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab update hotel\nDate: Thu, 08 Jan 2026 10:00:00 +0000\nMessage-ID: <mu-hotel@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of mu-hotel.\n"
      ]
    },
    {
      "folder": "Local Folders/Templates",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab template kilo\nDate: Thu, 09 Jan 2026 10:00:00 +0000\nMessage-ID: <mu-kilo@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of mu-kilo.\n"
      ]
    }
  ],
  "steps": [
    {
      "id": "accounts",
      "tool": "listAccounts",
      "timeout": 30,
      "arguments": {}
    },
    {
      "id": "index-trigger",
      "tool": "applyFilters",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      },
      "wait_after": 3,
      "note": "Seeded mbox files have no .msf summary; running the (empty) filter list over the folder makes Thunderbird parse it.",
      "retry": {
        "attempts": 10,
        "delay": 2
      }
    },
    {
      "id": "index-ready",
      "tool": "getMessage",
      "timeout": 30,
      "arguments": {
        "messageId": "mu-alpha@example.com",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "bodyFormat": "text"
      },
      "retry": {
        "attempts": 12,
        "delay": 3
      }
    },
    {
      "id": "templates-ready",
      "tool": "getMessage",
      "timeout": 30,
      "arguments": {
        "messageId": "mu-kilo@example.com",
        "folderPath": "mailbox://nobody@Local%20Folders/Templates",
        "bodyFormat": "text"
      },
      "retry": {
        "attempts": 12,
        "delay": 3
      }
    },
    {
      "id": "s-alpha-0",
      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "alpha",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      }
    },
    {
      "id": "um-read",
      "tool": "updateMessage",
      "timeout": 30,
      "arguments": {
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "messageId": "mu-alpha@example.com",
        "read": true
      }
    },
    {
      "id": "s-alpha-1",
      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "alpha",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      }
    },
    {
      "id": "um-flag",
      "tool": "updateMessage",
      "timeout": 30,
      "arguments": {
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "messageId": "mu-alpha@example.com",
        "flagged": true
      }
    },
    {
      "id": "s-alpha-2",
      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "alpha",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      }
    },
    {
      "id": "s-flagged",
      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "flaggedOnly": true
      }
    },
