      "type": "tool_ok",
      "step": "accounts"
    },
    {
      "type": "tool_ok",
      "step": "index-ready"
    },
    {
      "type": "tool_ok",
      "step": "trash-ready"
    },
    {
      "type": "tool_ok",
      "step": "drafts-ready"
    },
    {
      "type": "tool_result_contains",
      "step": "s-trash-0",
      "contains": "Lab delete lima"
    },
    {
      "type": "tool_result_contains",
      "step": "s-trash-0",
      "contains": "\"totalMatches\":1"
    },
    {
      "type": "tool_ok",
      "step": "del-one"
    },
    {
      "type": "tool_result_contains",
      "step": "del-one",
      "contains": "\"success\":true,\"deleted\":1,\"notFound\":[\"nope@example.com\"]"
    },
    {
      "type": "tool_result_contains",
      "step": "s-inbox-foxtrot",
      "contains": "\"totalMatches\":0",
      "note": "deleted from the Inbox"
    },
    {
      "type": "tool_result_contains",
      "step": "s-trash-1",
      "contains": "Lab delete foxtrot",
      "note": "...and found in the account's Trash"
    },
    {
      "type": "tool_result_contains",
      "step": "s-trash-1",
      "contains": "\"totalMatches\":2"
    },
    {
      "type": "tool_result_contains",
      "step": "del-two",
      "contains": "\"deleted\":2"
    },
    {
      "type": "tool_result_contains",
      "step": "s-trash-2",
      "contains": "\"totalMatches\":4"
    },
    {
