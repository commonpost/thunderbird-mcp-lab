      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "lima",
        "includeTrash": true
      }
    },
    {
      "id": "s-inbox",
      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "",
        "includeTrash": true,
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      }
    },
