{
  "name": "messages-delete-display",
  "description": "deleteMessages on seeded messages: one message (an id that does not exist is reported in notFound) and two messages at once go from the POP3 Inbox to its Trash, a message already in the Trash is deleted for good (it does not move anywhere), a message of the Drafts folder goes to the Trash of Local Folders (movedToTrash), and a message that was not deleted stays. displayMessage opens a message in the default (3pane), tab and window modes and returns its subject. The main errors are checked: empty or unknown message ids, unknown folder, missing arguments, an unknown message, an invalid displayMode. Limit: whether Thunderbird really shows the message is not observable; only the tool's answer is checked. Nothing is sent.",
  "prefs": {
    "mail.server.server2.directory-rel": "[ProfD]Mail/127.0.0.1"
  },
  "seed": [
    {
      "folder": "127.0.0.1/Inbox",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab delete foxtrot\nDate: Thu, 01 Jan 2026 10:00:00 +0000\nMessage-ID: <md-foxtrot@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of md-foxtrot.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab delete golf\nDate: Thu, 02 Jan 2026 10:00:00 +0000\nMessage-ID: <md-golf@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of md-golf.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab delete charlie\nDate: Thu, 03 Jan 2026 10:00:00 +0000\nMessage-ID: <md-charlie@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of md-charlie.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab delete delta\nDate: Thu, 04 Jan 2026 10:00:00 +0000\nMessage-ID: <md-delta@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of md-delta.\n",
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab delete mike\nDate: Thu, 05 Jan 2026 10:00:00 +0000\nMessage-ID: <md-mike@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of md-mike.\n"
      ]
    },
    {
      "folder": "127.0.0.1/Trash",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab delete lima\nDate: Thu, 06 Jan 2026 10:00:00 +0000\nMessage-ID: <md-lima@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of md-lima.\n"
      ]
    },
    {
      "folder": "Local Folders/Drafts",
      "messages": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: Lab delete juliet\nDate: Thu, 07 Jan 2026 10:00:00 +0000\nMessage-ID: <md-juliet@example.com>\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n\nBody of md-juliet.\n"
      ]
    }
  ],
  "steps": [
    {
      "id": "accounts",
      "tool": "listAccounts",
      "timeout": 30,
      "arguments": {}
    },
    {
      "id": "index-trigger",
      "tool": "applyFilters",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      },
      "wait_after": 3,
      "note": "Seeded mbox files have no .msf summary; running the (empty) filter list over the folder makes Thunderbird parse it.",
      "retry": {
        "attempts": 10,
        "delay": 2
      }
    },
    {
      "id": "index-ready",
      "tool": "getMessage",
      "timeout": 30,
      "arguments": {
        "messageId": "md-foxtrot@example.com",
        "folderPath": "mailbox://lab@127.0.0.1/Inbox",
        "bodyFormat": "text"
      },
      "retry": {
        "attempts": 12,
        "delay": 3
      }
    },
    {
      "id": "trash-ready",
      "tool": "getMessage",
      "timeout": 30,
      "arguments": {
        "messageId": "md-lima@example.com",
        "folderPath": "mailbox://lab@127.0.0.1/Trash",
        "bodyFormat": "text"
      },
      "retry": {
        "attempts": 12,
        "delay": 3
      }
    },
    {
      "id": "drafts-ready",
      "tool": "getMessage",
      "timeout": 30,
      "arguments": {
        "messageId": "md-juliet@example.com",
        "folderPath": "mailbox://nobody@Local%20Folders/Drafts",
        "bodyFormat": "text"
      },
      "retry": {
        "attempts": 12,
        "delay": 3
      }
    },
    {
      "id": "s-trash-0",
      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "",
        "includeTrash": true,
        "folderPath": "mailbox://lab@127.0.0.1/Trash"
      }
    },
    {
      "id": "del-one",
      "tool": "deleteMessages",
      "timeout": 30,
      "arguments": {
        "messageIds": [
          "md-foxtrot@example.com",
          "nope@example.com"
        ],
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      }
    },
    {
      "id": "s-inbox-foxtrot",
      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "foxtrot",
        "includeTrash": true,
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      }
    },
    {
      "id": "s-trash-1",
      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "",
        "includeTrash": true,
        "folderPath": "mailbox://lab@127.0.0.1/Trash"
      }
    },
    {
      "id": "del-two",
      "tool": "deleteMessages",
      "timeout": 30,
      "arguments": {
        "messageIds": [
          "md-charlie@example.com",
          "md-delta@example.com"
        ],
        "folderPath": "mailbox://lab@127.0.0.1/Inbox"
      }
    },
    {
      "id": "s-trash-2",
      "tool": "searchMessages",
      "timeout": 30,
      "arguments": {
        "query": "",
        "includeTrash": true,
        "folderPath": "mailbox://lab@127.0.0.1/Trash"
      }
