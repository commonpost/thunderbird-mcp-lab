      "step": "s-trash-2",
      "contains": "Lab delete charlie"
    },
    {
      "type": "tool_result_contains",
      "step": "s-trash-2",
      "contains": "Lab delete delta"
    },
    {
      "type": "tool_result_contains",
      "step": "del-in-trash",
      "contains": "\"deleted\":1"
    },
    {
