    },
    {
      "type": "tool_result_contains",
      "step": "s-inbox",
      "contains": "Lab delete mike"
    },
    {
      "type": "tool_result_contains",
      "step": "s-inbox",
      "contains": "\"totalMatches\":2"
    },
    {
      "type": "tool_result_contains",
      "step": "del-draft",
