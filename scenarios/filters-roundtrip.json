        "accountId": "account2",
        "name": "lab-killThread",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-killThread"
          }
        ],
        "actions": [
          {
            "type": "killThread"
          }
        ]
      }
    },
    {
      "id": "create-watchThread",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-watchThread",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-watchThread"
          }
        ],
        "actions": [
          {
            "type": "watchThread"
          }
        ]
      }
    },
    {
      "id": "create-age",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-age",
        "conditions": [
          {
            "attrib": "ageInDays",
            "op": "isGreaterThan",
            "value": "30"
          }
        ],
        "actions": [
          {
            "type": "moveToFolder",
            "value": "mailbox://nobody@Local%20Folders/lab-target"
          }
        ]
      }
    },
    {
      "id": "list1",
      "tool": "listFilters",
      "arguments": {
        "accountId": "account2"
      },
      "timeout": 30
    },
    {
      "id": "update-age-action",
      "tool": "updateFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "filterIndex": 11,
        "actions": [
          {
            "type": "markRead"
          }
        ]
      }
    },
    {
      "id": "update-move-conditions",
      "tool": "updateFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "filterIndex": 0,
        "conditions": [
          {
            "attrib": "from",
            "op": "contains",
            "value": "boss@example.com"
          }
        ]
      }
    },
    {
      "id": "list2",
      "tool": "listFilters",
      "arguments": {
        "accountId": "account2"
      },
      "timeout": 30
    }
  ],
  "inspect": {
    "prefs": [
      "extensions.thunderbird-mcp."
    ]
  },
