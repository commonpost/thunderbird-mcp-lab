{
  "name": "filters-roundtrip",
  "description": "Filter round trip through the tools, for every action type except forward/reply: createFilter, then what listFilters reports must match what was requested (action type, value, condition). Then updateFilter changes the action of an age-based filter and the conditions of another one; listFilters must show the change and keep the untouched parts. Nothing is sent. Known upstream issues (enum/value typing, see TKasperczyk/thunderbird-mcp#175 and #195) are marked xfail.",
  "startup_timeout": 240,
  "prefs": {
    "mail.server.server2.directory-rel": "[ProfD]Mail/127.0.0.1"
  },
  "steps": [
    {
      "id": "accounts",
      "tool": "listAccounts",
      "arguments": {},
      "timeout": 30
    },
    {
      "id": "folder",
      "tool": "createFolder",
      "arguments": {
        "parentFolderPath": "mailbox://nobody@Local%20Folders",
        "name": "lab-target"
      },
      "timeout": 30,
      "wait_after": 2
    },
    {
      "id": "create-moveToFolder",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-moveToFolder",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-moveToFolder"
          }
        ],
        "actions": [
          {
            "type": "moveToFolder",
            "value": "mailbox://nobody@Local%20Folders/lab-target"
          }
        ]
      }
    },
    {
      "id": "create-copyToFolder",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-copyToFolder",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-copyToFolder"
          }
        ],
        "actions": [
          {
            "type": "copyToFolder",
            "value": "mailbox://nobody@Local%20Folders/lab-target"
          }
        ]
      }
    },
    {
      "id": "create-markRead",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-markRead",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-markRead"
          }
        ],
        "actions": [
          {
            "type": "markRead"
          }
        ]
      }
    },
    {
      "id": "create-markUnread",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-markUnread",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-markUnread"
          }
        ],
        "actions": [
          {
            "type": "markUnread"
          }
        ]
      }
    },
    {
      "id": "create-markFlagged",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-markFlagged",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-markFlagged"
          }
        ],
        "actions": [
          {
            "type": "markFlagged"
          }
        ]
      }
    },
    {
      "id": "create-addTag",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-addTag",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-addTag"
          }
        ],
        "actions": [
          {
            "type": "addTag",
            "value": "$label1"
          }
        ]
      }
    },
    {
      "id": "create-changePriority",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-changePriority",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-changePriority"
          }
        ],
        "actions": [
          {
            "type": "changePriority",
            "value": "6"
          }
        ]
      }
    },
    {
      "id": "create-delete",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-delete",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-delete"
          }
        ],
        "actions": [
          {
            "type": "delete"
          }
        ]
      }
    },
    {
      "id": "create-stopExecution",
      "tool": "createFilter",
      "timeout": 30,
      "arguments": {
        "accountId": "account2",
        "name": "lab-stopExecution",
        "conditions": [
          {
            "attrib": "subject",
            "op": "contains",
            "value": "lab-stopExecution"
          }
        ],
        "actions": [
          {
            "type": "stopExecution"
          }
        ]
      }
