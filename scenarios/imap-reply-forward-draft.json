{
  "name": "imap-reply-forward-draft",
  "description": "The lab's IMAP account (key imap: a local Dovecot server with one message in INBOX and an empty Drafts folder), with the drafts of its identity id3 kept on the server. listAccounts shows account3 as an IMAP account; the folders are refreshed, the original is found and read from the server; then saveDraft, replyToMessage with mode draft, saveDraft again and forwardMessage with mode draft all succeed and name the IMAP Drafts folder, then that folder holds four messages and a search of it finds the four drafts, the reply (Re:) and the forward (Fwd:) among them. No draft lands in Local Folders and nothing is sent. Not covered: the headers and bodies of the drafts saved on the server (the draft checks read local mbox files), sending from the IMAP account, offline copies and several IMAP connections at once.",
  "imap": {
    "folders": {
      "INBOX": [
        "From: Alice Example <alice@example.com>\nTo: Lab User <lab@example.test>\nSubject: labimap1 original\nDate: Thu, 01 Jan 2026 10:00:00 +0000\nMessage-ID: <labimap1-orig@example.com>\nMIME-Version: 1.0\nContent-Transfer-Encoding: 8bit\nContent-Type: text/plain; charset=UTF-8\n\nBody of the IMAP original, labimap1-body.\n"
      ],
      "Drafts": []
    }
  },
  "prefs": {
    "mail.identity.id3.draft_folder": "imap://tblab@127.0.0.1/Drafts"
  },
  "steps": [
    {
      "id": "accounts",
      "tool": "listAccounts",
      "timeout": 30,
      "arguments": {},
      "note": "Thunderbird logs in to the IMAP server at startup and lists its folders: give it time.",
      "wait_after": 10
    },
    {
      "id": "inbox",
      "tool": "listFolders",
      "timeout": 60,
      "arguments": {
        "folderPath": "imap://tblab@127.0.0.1/INBOX",
        "refresh": true
      },
      "retry": {
        "attempts": 6,
        "delay": 5
      }
    },
    {
      "id": "drafts-folder",
      "tool": "listFolders",
      "timeout": 60,
      "arguments": {
        "folderPath": "imap://tblab@127.0.0.1/Drafts",
        "refresh": true
      },
      "retry": {
        "attempts": 6,
        "delay": 5
      }
    },
    {
      "id": "find",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "labimap1",
        "folderPath": "imap://tblab@127.0.0.1/INBOX"
      },
      "retry": {
        "attempts": 6,
        "delay": 5
      }
    },
    {
      "id": "read",
      "tool": "getMessage",
      "timeout": 60,
      "arguments": {
        "messageId": "labimap1-orig@example.com",
        "folderPath": "imap://tblab@127.0.0.1/INBOX"
      },
      "note": "The body is not stored in the profile: Thunderbird fetches it from the server for this call.",
      "retry": {
        "attempts": 3,
        "delay": 5
      }
    },
    {
      "id": "plain-before",
      "tool": "saveDraft",
      "timeout": 150,
      "arguments": {
        "to": "recipient@example.com",
        "subject": "labimap1 plain before",
        "body": "<p>Plain draft, before.</p>",
        "isHtml": true,
        "from": "id3"
      }
    },
    {
      "id": "reply",
      "tool": "replyToMessage",
      "timeout": 175,
      "arguments": {
        "messageId": "labimap1-orig@example.com",
        "folderPath": "imap://tblab@127.0.0.1/INBOX",
        "body": "<p>Reply to the IMAP original.</p>",
        "replyAll": false,
        "mode": "draft",
        "isHtml": true
      }
    },
    {
      "id": "plain-after",
      "tool": "saveDraft",
      "timeout": 150,
      "arguments": {
        "to": "recipient@example.com",
        "subject": "labimap1 plain after",
        "body": "<p>Plain draft, after.</p>",
        "isHtml": true,
        "from": "id3"
      }
    },
    {
      "id": "forward",
      "tool": "forwardMessage",
      "timeout": 175,
      "arguments": {
        "messageId": "labimap1-orig@example.com",
        "folderPath": "imap://tblab@127.0.0.1/INBOX",
        "to": "dave@example.com",
        "body": "<p>Forward of the IMAP original.</p>",
        "mode": "draft",
        "isHtml": true
      },
      "wait_after": 8,
      "note": "Thunderbird updates its view of the Drafts folder shortly after the draft is stored on the server: give it time before the folder is listed and searched."
    },
    {
      "id": "drafts-count",
      "tool": "listFolders",
      "timeout": 60,
      "arguments": {
        "folderPath": "imap://tblab@127.0.0.1/Drafts"
      }
    },
    {
      "id": "drafts-list",
      "tool": "searchMessages",
      "timeout": 60,
      "arguments": {
        "query": "labimap1",
        "folderPath": "imap://tblab@127.0.0.1/Drafts"
      },
      "retry": {
        "attempts": 6,
        "delay": 5
      }
    }
  ],
  "checks": [
    {
      "type": "tool_result_contains",
      "step": "accounts",
      "contains": "\"id\":\"account3\""
    },
    {
      "type": "tool_result_contains",
      "step": "accounts",
      "contains": "\"type\":\"imap\""
    },
    {
      "type": "tool_result_contains",
      "step": "accounts",
      "contains": "\"id\":\"id3\""
    },
    {
      "type": "tool_ok",
      "step": "inbox"
    },
    {
      "type": "tool_ok",
      "step": "drafts-folder"
    },
    {
      "type": "tool_result_contains",
      "step": "find",
      "contains": "labimap1-orig@example.com"
    },
    {
      "type": "tool_result_contains",
      "step": "read",
      "contains": "labimap1-body",
      "note": "Fetched from the server on demand."
    },
    {
      "type": "tool_ok",
      "step": "plain-before"
    },
    {
      "type": "tool_result_contains",
      "step": "plain-before",
      "contains": "imap://tblab@127.0.0.1/Drafts"
    },
    {
      "type": "tool_ok",
      "step": "reply"
    },
    {
      "type": "tool_result_contains",
      "step": "reply",
      "contains": "imap://tblab@127.0.0.1/Drafts"
    },
    {
      "type": "tool_result_contains",
      "step": "reply",
      "contains": "Re: labimap1 original"
    },
    {
      "type": "tool_ok",
      "step": "plain-after"
    },
    {
      "type": "tool_ok",
      "step": "forward"
    },
    {
      "type": "tool_result_contains",
      "step": "forward",
      "contains": "imap://tblab@127.0.0.1/Drafts"
    },
    {
      "type": "tool_result_contains",
      "step": "forward",
      "contains": "Fwd: labimap1 original"
    },
    {
      "type": "tool_result_contains",
      "step": "drafts-count",
      "contains": "\"totalMessages\":4"
    },
    {
      "type": "tool_result_contains",
      "step": "drafts-list",
      "contains": "Re: labimap1 original",
      "note": "The reply draft is in the IMAP Drafts folder."
    },
    {
      "type": "tool_result_contains",
      "step": "drafts-list",
      "contains": "Fwd: labimap1 original",
      "note": "So is the forward draft."
    },
    {
      "type": "tool_result_contains",
      "step": "drafts-list",
      "contains": "labimap1 plain before"
    },
    {
      "type": "tool_result_contains",
      "step": "drafts-list",
      "contains": "labimap1 plain after"
    },
    {
      "type": "draft_count",
      "subject": "labimap1",
      "equals": 0,
      "note": "No draft in the mbox files of the profile: they are on the server."
    },
    {
      "type": "mailpit_total",
      "equals": 0
    }
  ]
}
